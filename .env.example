# External MTProxy TCP port
PORT=443

# Internal HTTP statistics port
STATS_PORT=2398

# Fake TLS domain
DOMAIN=www.cloudflare.com

# Usually 1 is enough for a small server
WORKERS=1

# Recommended when using Docker bridge networking.
# Put your VPS public IPv4 here, for example:
# EXTERNAL_IP=203.0.113.10
EXTERNAL_IP=

# Optional tag obtained from @MTProxybot
PROXY_TAG=
